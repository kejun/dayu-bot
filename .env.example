# 阿里云 Model Studio / 百炼。填写同一地域、同一业务空间的凭据与地址。
# Base URL 填到 /compatible-mode/v1；不要加 /chat/completions。
# 例如北京公共 endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
# 若控制台提供 Workspace 专属 endpoint，请使用控制台给出的地址。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# 手机 Agent 主模型及辅助调用统一使用千问，代码固定 enable_thinking=false。
QWEN_MODEL=qwen-flash
# 主模型单次请求超时（秒）；每轮执行总时限单独控制，支持长任务。
QWEN_REQUEST_TIMEOUT=30
AGENT_TIMEOUT=21600
BRIDGE_AGENT_BACKEND=direct
# 每次执行最多 3000 步；暂停等待用户回答不计入执行总时限。
QWEN_MAX_STEPS=3000
QWEN_MAX_OUTPUT_TOKENS=384
# 复杂口语任务先整理目标、入口、步骤和待确认信息；简单只读跳过额外云端规划。
QWEN_PLAN_MAX_TOKENS=768
QWEN_PLAN_TIMEOUT=8
# iCTRL 单次请求上限；取消会等待已派发动作在该上限内返回。
PHONE_RPC_TIMEOUT=8
PHONE_SCREEN_CHARS=6000
PHONE_FAST_LAUNCH=true
PHONE_READY_READS=3

# 云端语音转文字。以下两项留空时复用 DASHSCOPE_API_KEY / BASE_URL。
QWEN_ASR_API_KEY=
QWEN_ASR_BASE_URL=
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_LANGUAGE=zh
QWEN_ASR_TIMEOUT=15

# 云端语音播报：复用上面的凭据与服务域名，通过 WebSocket 输出 16kHz PCM。
# 可单独填写完整 wss://.../api-ws/v1/inference；留空从 DASHSCOPE_BASE_URL 推导。
QWEN_TTS_API_KEY=
QWEN_TTS_BASE_URL=
QWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QWEN_TTS_VOICE=longanxiaoxin
QWEN_TTS_TIMEOUT=15

# 手机 Runner 与 ESP32 Bridge。
ICTRL_HOST=127.0.0.1:8200
BRIDGE_BIND=0.0.0.0
BRIDGE_PORT=8765
BRIDGE_TOKEN=
# 已有认证文件时可使用它，避免更换设备侧的共享密钥。
# BRIDGE_TOKEN_FILE=~/.dayu/bridge_token
